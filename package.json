{
  "name": "ai-video-app",
  "private": true,
  "version": "7.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:member": "vite --force --config vite.config.ts --host 0.0.0.0 --port 3000 --strictPort",
    "dev:admin": "vite --force --config vite.admin.config.ts --host 0.0.0.0 --port 3001 --strictPort",
    "dev:control": "node server/control-plane/index.mjs",
    "dev:all": "node scripts/cloudstudio-run.mjs",
    "cloudstudio": "node scripts/cloudstudio-run.mjs",
    "cloudstudio:wait-admin": "node scripts/wait-for-service.mjs http://127.0.0.1:3001/control/health 900000",
    "cloudstudio:package": "node scripts/create-cloudstudio-package.mjs",
    "build": "tsc -b && vite build",
    "build:member": "npm run build",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:all": "npm run build:member && npm run build:admin",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:control": "node --test tests/control-plane.test.mjs",
    "test:all": "npm test && npm run test:control",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm run test:all && npm run build:all"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@phosphor-icons/react": "2.1.10",
    "gsap": "3.13.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
