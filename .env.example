# Leave secrets empty in source control. Inject production values through the
# deployment platform's encrypted environment settings.
CONTROL_PLANE_MASTER_KEY=
CONTROL_PLANE_DATA_FILE=server/control-plane/data/control-plane.json
CONTROL_PLANE_ALLOWED_ORIGINS=
CONTROL_PLANE_SECURE_COOKIE=0
CONTROL_PLANE_TRUST_PROXY=0

# Server-side Vite proxy target. This is not exposed to browser code.
CONTROL_PROXY_TARGET=http://127.0.0.1:8788
